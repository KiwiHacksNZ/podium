# Copy to `.env` (repo root, picked up by `docker compose`) and/or `backend/.env`
# (loaded by Dynaconf when running `uv run podium` directly). All app settings use
# the PODIUM_ prefix; see backend/settings.toml for non-secret defaults.

# Required
PODIUM_DATABASE_URL=postgresql+asyncpg://postgres:localpass@localhost:5432/podium?sslmode=disable
PODIUM_JWT_SECRET=local-dev-jwt-secret-change-me

# Optional
PODIUM_PRODUCTION_URL=http://localhost:5173
PODIUM_ACTIVE_EVENT_SERIES=test-series
PODIUM_TURNSTILE_SECRET_KEY=
PODIUM_LOOPS_API_KEY=
PODIUM_LOOPS_TRANSACTIONAL_ID=
PODIUM_SSO_CLIENT_ID=
PODIUM_SSO_CLIENT_SECRET=
PODIUM_SENTRY_DSN=
