{
  "version": "0.2.0",
  "configurations": [
    {
      // To run bun dev in prod mode:
      // MacOS/Linux: NODE_ENV=production bun run dev
      // Windows (powershell): $env:NODE_ENV="production"; bun run dev; $env:NODE_ENV=""
      "name": "frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["podium.main:app", "--reload"],
      // Secrets load from backend/.env via Dynaconf (see .env.example).
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "dev",
      "configurations": ["frontend", "FastAPI"]
    }
  ]
}
